{
  "compilerOptions": {
    "target": "ES2022",
    // Only standard JavaScript plus the web APIs every supported runtime has (fetch, Headers,
    // FormData, Blob, AbortSignal, Web Crypto, TextEncoder), which @types/node 22 declares.
    // No DOM library: the SDK never runs in a browser.
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "*.ts"]
}
