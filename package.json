{
  "name": "@flashpi/node",
  "version": "0.0.0",
  "description": "Official Node.js and TypeScript SDK for Flashpi, the electronic invoicing API for Ecuador's SRI.",
  "license": "MIT",
  "author": "SIGNIADIGITAL S.A.",
  "homepage": "https://flashpi.com.ec/docs/sdks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashpi1/flashpi-node.git"
  },
  "bugs": {
    "url": "https://github.com/flashpi1/flashpi-node/issues"
  },
  "keywords": [
    "flashpi",
    "sri",
    "ecuador",
    "facturacion-electronica",
    "factura-electronica",
    "e-invoicing",
    "invoice",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/index.node.mjs",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "volta": {
    "node": "24.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && publint --strict && attw --pack . --profile node16",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.consumer.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:runtimes": "node test/runtimes/esm.mjs && node test/runtimes/cjs.cjs && node test/runtimes/single-copy.mjs && node test/runtimes/race.mjs && node test/runtimes/workers.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "openapi:sync": "node scripts/openapi.mjs sync",
    "openapi:generate": "node scripts/openapi.mjs generate",
    "openapi:check": "node scripts/openapi.mjs check",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "miniflare": "^4.20260730.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
